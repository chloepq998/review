# Firebase 프로젝트 설정 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱 에서 확인)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM 웹 푸시용 VAPID 키 (Firebase Console > 프로젝트 설정 > 클라우드 메시징 > 웹 구성)
VITE_FIREBASE_VAPID_KEY=

# Claude API 키 (서버 사이드 전용, Vercel 서버리스 함수 /api 에서만 사용 — VITE_ 접두사 붙이지 말 것)
ANTHROPIC_API_KEY=

# 웹 푸시 리마인더 발송용 (서버 사이드 전용). Firebase Console > 프로젝트 설정 >
# 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON 파일 내용을 한 줄로 그대로 붙여넣는다.
FIREBASE_SERVICE_ACCOUNT=

# /api/send-reminders 를 Vercel Cron 외의 요청으로부터 보호하기 위한 임의의 비밀값 (선택).
# 설정하면 Vercel이 Cron 호출 시 자동으로 Authorization: Bearer <값> 헤더를 붙여 보낸다.
CRON_SECRET=
