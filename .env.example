# Firebase 프로젝트 설정 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱 에서 확인)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM 웹 푸시용 VAPID 키 (Firebase Console > 프로젝트 설정 > 클라우드 메시징 > 웹 구성)
VITE_FIREBASE_VAPID_KEY=

# Claude API 키 (서버 사이드 전용, Vercel 서버리스 함수 /api 에서만 사용 — VITE_ 접두사 붙이지 말 것)
ANTHROPIC_API_KEY=
